@page "/"
@inject SoundLabsApi Api
@inject CartState CartStore
@inject AuthStore Auth
@inject NavigationManager Nav
<PageTitle>SoundLabs — музыкальный магазин</PageTitle>

<section class="hero">
    <div class="shell hero-inner">
        <div class="hero-copy">
            <p class="hero-kicker" style="--i:0">Музыкальный магазин и сервисная мастерская</p>
            <h1 style="--i:1">Твой звук.<br />Твои правила.</h1>
            <p class="hero-lead" style="--i:2">Гитары, клавишные, ударные и студийное оборудование. Поможем выбрать инструмент и сохранить его звучание.</p>
            <div class="hero-buttons" style="--i:3">
                <a class="btn btn-cream" href="/catalog">Перейти в каталог <svg class="arrow-ico" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
                <a class="btn btn-ghost" href="/services">Сервисная мастерская</a>
            </div>
        </div>
        <div class="hero-card">
            <img src="images/placeholder.png" alt="Электрогитара" />
        </div>
    </div>

    <div class="keys" aria-hidden="true">
        @for (var k = 0; k < KeyCount; k++)
        {
            <span class="wk" style="--k:@k"></span>
        }
        @for (var k = 0; k < KeyCount - 1; k++)
        {
            if (HasBlackKey(k))
            {
                <span class="bkey" style="--k:@k"></span>
            }
        }
    </div>
</section>

@if (loading || categories.Count > 0)
{
    <section class="sheet sheet-ink sheet-flat">
        <div class="shell">
            <div class="sec-head reveal">
                <h2>Что ищешь сегодня?</h2>
                <a class="text-link" href="/catalog">Весь каталог <svg class="arrow-ico" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
            </div>
            @if (loading)
            {
                <div class="loader"><div class="eq"><i></i><i></i><i></i><i></i></div>Загружаем категории…</div>
            }
            <div class="cat-list">
                @for (var i = 0; i < categories.Count; i++)
                {
                    var c = categories[i];
                    <a class="cat-row reveal" style="--i:@i" href="@($"/catalog?categoryId={c.id}")">
                        <span class="cat-name">@c.name</span>
                        <span class="cat-desc">@(string.IsNullOrWhiteSpace(c.description) ? "Смотреть товары категории" : c.description)</span>
                        <span class="cat-arrow"><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
                    </a>
                }
            </div>
        </div>
    </section>
}

<section class="sheet sheet-cream @(!loading && categories.Count == 0 ? "sheet-flat" : "")">
    <div class="shell about-grid">
        <div class="about-photo reveal">
            <img src="images/banner.jpg" alt="музыка" />
        </div>
        <div class="about-copy reveal" style="--i:1">
            <h2>Магазин, где инструмент не остаётся один</h2>
            <p>SoundLabs — это музыкальные инструменты и оборудование с собственной сервисной мастерской. Мы подберём инструмент под ваши задачи, а когда ему понадобится настройка или ремонт, вы принесёте его к нам же.</p>
            <p>Выбирайте товары в каталоге, оформляйте заказ с самовывозом или доставкой и следите за статусом в личном кабинете.</p>
            @if (!loading && string.IsNullOrEmpty(error))
            {
                <div class="stats">
                    <div class="stat"><b class="count" style="--target:@products.Count"></b><span>товаров в каталоге</span></div>
                    <div class="stat"><b class="count" style="--target:@categories.Count"></b><span>категорий</span></div>
                    <div class="stat"><b class="count" style="--target:@services.Count"></b><span>услуг мастерской</span></div>
                    <div class="stat"><b>10–20</b><span>работаем ежедневно</span></div>
                </div>
            }
        </div>
    </div>
</section>

<section class="sheet sheet-ink">
    <div class="shell">
        <div class="sec-head reveal">
            <h2>Выбор музыкантов</h2>
            <a class="text-link" href="/catalog">Смотреть все <svg class="arrow-ico" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
        </div>
        @if (loading)
        {
            <div class="loader"><div class="eq"><i></i><i></i><i></i><i></i></div>Загружаем каталог…</div>
        }
        else if (!string.IsNullOrEmpty(error))
        {
            <p class="error">@error</p>
        }
        else
        {
            <div class="product-grid">
                @for (var i = 0; i < Math.Min(4, products.Count); i++)
                {
                    var p = products[i];
                    <article class="product-card reveal" style="--i:@i">
                        <div class="product-photo">
                            <img src="@Api.ProductImageUrl(p.ImageUrl)" alt="@p.Name" />
                            <span class="product-tag">@p.Category</span>
                        </div>
                        <div class="product-info">
                            <h3>@p.Name</h3>
                            <div class="stock @(p.Available > 0 ? "" : "out")">@(p.Available > 0 ? "В наличии" : "Нет в наличии")</div>
                            <div class="product-bottom">
                                <b>@p.Price.ToString("N0") ₽</b>
                                <button class="add-btn" disabled="@(p.Available < 1)" @onclick="() => CartStore.Add(p)">В корзину</button>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>

<section class="sheet sheet-wine">
    <div class="shell service-inner">
        <div class="reveal">
            <h2>Инструменту нужен правильный уход</h2>
            <p>Диагностика, настройка и ремонт музыкальных инструментов. Оставьте заявку — мастер свяжется с вами.</p>
            <a class="btn btn-cream" href="/services">Сервисная мастерская <svg class="arrow-ico" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
        </div>
        <div class="vinyl-wrap reveal" style="--i:1">
            <div class="vinyl"><div class="vinyl-label">SoundLabs<small>service</small></div></div>
        </div>
    </div>
</section>

@code {
    const int KeyCount = 21;

    List<Product> products = new();
    List<Category> categories = new();
    List<ShopService> services = new();
    bool loading = true;
    string? error;

    // Чёрные клавиши стоят после До, Ре, Фа, Соль, Ля (внутри каждой октавы из 7 белых клавиш)
    static bool HasBlackKey(int k) => (k % 7) is 0 or 1 or 3 or 4 or 5;

    protected override async Task OnInitializedAsync()
    {
        // Сотрудники не используют витрину магазина как стартовую страницу.
        var target = Auth.Role switch
        {
            "Администратор" => "/manage/employees",
            "Менеджер" => "/manage/orders",
            "Мастер" => "/repairs",
            _ => null
        };
        if (target is not null)
        {
            Nav.NavigateTo(target, replace: true);
            return;
        }

        try
        {
            products = await Api.Products();
            categories = await Api.Categories();
            services = await Api.Services();
        }
        catch (Exception e)
        {
            error = e.Message;
        }
        finally
        {
            loading = false;
        }
    }
}
